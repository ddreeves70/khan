{
  "scripts": {
    "tag": [
      "run --save tag.khan feature.add_box name=Plate size=60,30,4",
      "run --open tag.khan --save tag.khan feature.add_cylinder name=Hole base=9,15,-1 radius=2.5 height=6",
      "run --open tag.khan --save tag.khan feature.add_boolean name=Tag operation=cut a=Plate b=Hole"
    ],
    "organizer": [
      "run --save o.khan feature.add_box name=Base size=120,60,8",
      "run --open o.khan --save o.khan feature.add_cylinder name=Cup base=30,30,0 radius=22 height=80",
      "run --open o.khan --save o.khan feature.add_boolean name=Body operation=union a=Base b=Cup",
      "run --open o.khan --save o.khan feature.add_cylinder name=PenHole base=30,30,6 radius=18 height=80",
      "run --open o.khan --save o.khan feature.add_boolean name=Hollow operation=cut a=Body b=PenHole",
      "run --open o.khan --save o.khan feature.add_box name=Slot corner=65,24,4 size=45,12,5",
      "run --open o.khan --save o.khan feature.add_boolean name=Organizer operation=cut a=Hollow b=Slot"
    ],
    "parts": [
      "run --save p.khan feature.add_box size=30,30,10",
      "run --open p.khan --save p.khan feature.add_cylinder base=30,15,0 radius=10 height=20"
    ]
  },

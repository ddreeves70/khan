# Doxygen settings for Khan's public API documentation.
# Build with:  cmake --build --preset dev --target docs
# or directly: mkdir -p build/docs && doxygen docs/Doxyfile   (from the repository root)
# Output goes to build/docs/html/index.html.

PROJECT_NAME           = Khan
PROJECT_BRIEF          = "Free, open-source parametric CAD"
OUTPUT_DIRECTORY       = build/docs
CREATE_SUBDIRS         = NO

# Public headers only: they are the API. Implementation files are not documented here.
INPUT                  = docs/api-mainpage.md \
                         src/core/include \
                         src/kernel/include \
                         src/kernel_occt/include \
                         src/model/include \
                         src/io/include \
                         src/plugin/include \
                         src/ui/include \
                         src/view/include \
                         plugins/modeling/include \
                         plugins/viewer/include \
                         docs/plugin-guide
FILE_PATTERNS          = *.h *.md
RECURSIVE              = YES
# The guide's example plugins are teaching code, shown on the guide pages.
EXCLUDE_PATTERNS       = */plugin-guide/sharing/*
USE_MDFILE_AS_MAINPAGE = docs/api-mainpage.md
STRIP_FROM_PATH        = src
STRIP_FROM_INC_PATH    = src/core/include src/kernel/include src/kernel_occt/include src/model/include
FULL_PATH_NAMES        = YES

# Javadoc style: the first sentence of a /// comment is the brief description.
JAVADOC_AUTOBRIEF      = YES
QT_AUTOBRIEF           = NO
MARKDOWN_SUPPORT       = YES
BUILTIN_STL_SUPPORT    = YES

# Show only what is public. Private members and anonymous namespaces stay out.
EXTRACT_ALL            = NO
EXTRACT_PRIVATE        = NO
EXTRACT_STATIC         = YES
EXTRACT_ANON_NSPACES   = NO
HIDE_UNDOC_MEMBERS     = NO
HIDE_UNDOC_CLASSES     = NO
HIDE_FRIEND_COMPOUNDS  = YES
INTERNAL_DOCS          = NO
SORT_MEMBER_DOCS       = NO

# Every public item must be documented. CI fails on any warning.
QUIET                  = YES
WARNINGS               = YES
WARN_IF_UNDOCUMENTED   = YES
WARN_IF_DOC_ERROR      = YES
WARN_IF_INCOMPLETE_DOC = YES
WARN_NO_PARAMDOC       = YES
WARN_AS_ERROR          = FAIL_ON_WARNINGS
WARN_FORMAT            = "$file:$line: $text"

ENABLE_PREPROCESSING   = YES
MACRO_EXPANSION        = NO

GENERATE_HTML          = YES
HTML_OUTPUT            = html
GENERATE_TREEVIEW      = YES
SEARCHENGINE           = YES
GENERATE_LATEX         = NO
HAVE_DOT               = NO
SOURCE_BROWSER         = NO
